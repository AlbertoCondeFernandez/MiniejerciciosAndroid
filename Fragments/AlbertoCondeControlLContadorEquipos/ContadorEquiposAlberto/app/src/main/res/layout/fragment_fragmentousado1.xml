<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"

    android:orientation="vertical"
    tools:context=".Fragmentousado1">

    <!-- TODO: Update blank fragment layout -->

    <EditText
        android:id="@+id/nombreEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/nombre_equipo"
        android:padding="20sp"
        android:text="@string/e1"
        android:textColor="#C45CE4"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/puntaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:inputType="text"
        android:text="0 puntos"
        android:textSize="20sp"
        android:textStyle="bold" />


    <Button
        android:id="@+id/suma1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#CA9F2A"
        android:text="Sumar 1"
        android:textColor="@color/white"></Button>

    <Button
        android:id="@+id/suma2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#BD671B"
        android:text="Sumar 2"
        android:textColor="@color/white">

    </Button>

    <Button
        android:id="@+id/suma5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#E78026"
        android:text="Sumar 5"
        android:textColor="@color/white"></Button>

</LinearLayout>


