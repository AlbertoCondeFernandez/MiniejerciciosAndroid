<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFFB"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">


    <EditText
        android:id="@+id/nombreEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/nombre_equipo"
        android:backgroundTint="#A4D3EE"
        android:gravity="center"
        android:padding="10dp"
        android:text="Nombre"
        android:textColor="#C45CE4"
        android:textSize="20sp"
        android:textStyle="bold" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Botón Sumar 1 -->
        <TextView
            android:id="@+id/puntaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:gravity="center"
            android:text="0 puntos"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/suma1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="#CA9F2A"
            android:padding="10dp"
            android:text="Sumar 1"
            android:textColor="@color/white" />


        <Button
            android:id="@+id/suma2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="#BD671B"
            android:padding="10dp"
            android:text="Sumar 2"
            android:textColor="@color/white" />


        <Button
            android:id="@+id/suma5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:backgroundTint="#E78026"
            android:padding="10dp"
            android:text="Sumar 5"
            android:textColor="@color/white" />

    </LinearLayout>


